<Window x:Class="Continuum.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Continuum" Height="640" Width="860"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Сводка последней сессии (счётчики из БД) -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="ПОСЛЕДНЯЯ СЕССИЯ" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding SessionSummaryText}" FontSize="13"/>
        </StackPanel>

        <!-- Вердикт «Где я остановился?» (движок шага 5) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="ГДЕ Я ОСТАНОВИЛСЯ?" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding VerdictText}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBlock Text="{Binding VerdictDetail}" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Проект: " FontSize="12"/>
                <TextBlock Text="{Binding ProjectText}" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Text="    Git: " FontSize="12" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding GitText}" FontSize="12"/>
                <TextBlock Text="    Файл: " FontSize="12" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding LastFileText}" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <!-- Действия -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Обновить" Command="{Binding RefreshCommand}" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="Построить план" Command="{Binding RestorePlan.BuildCommand}" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="Dry-run" Command="{Binding RestorePlan.DryRunCommand}" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="Восстановить" Command="{Binding RestorePlan.ExecuteCommand}" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="Настройки" Command="{Binding OpenSettingsCommand}" Padding="12,4"/>
        </StackPanel>

        <!-- Хронология последней сессии -->
        <DockPanel Grid.Row="3">
            <TextBlock DockPanel.Dock="Top" Text="ХРОНОЛОГИЯ" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Timeline.SummaryText}" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
            <ListBox ItemsSource="{Binding Timeline.Events}" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </DockPanel>

        <GridSplitter Grid.Row="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" Background="LightGray" Height="5"/>

        <!-- План восстановления -->
        <DockPanel Grid.Row="5">
            <TextBlock DockPanel.Dock="Top" Text="ПЛАН ВОССТАНОВЛЕНИЯ" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding RestorePlan.PlanSummary}" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
            <ListBox ItemsSource="{Binding RestorePlan.Steps}" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Seq}" Width="24" Foreground="Gray"/>
                            <TextBlock Text="{Binding StrategyText}" Width="150"/>
                            <TextBlock Text="{Binding Target}" Width="330" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ResultText}" Width="80" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Error}" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
