<Window x:Class="Continuum.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Continuum" Height="480" Width="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Сводка последней сессии (счётчики из БД) -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="ПОСЛЕДНЯЯ СЕССИЯ" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding SessionSummaryText}" FontSize="13"/>
        </StackPanel>

        <!-- Вердикт «Где я остановился?» (движок шага 5) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="ГДЕ Я ОСТАНОВИЛСЯ?" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding VerdictText}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding VerdictDetail}" FontSize="12" Foreground="Gray" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Проект: " FontSize="12"/>
                <TextBlock Text="{Binding ProjectText}" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Text="    Git: " FontSize="12" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding GitText}" FontSize="12"/>
                <TextBlock Text="    Файл: " FontSize="12" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding LastFileText}" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <!-- Действия -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Обновить" Command="{Binding RefreshCommand}"
                    Padding="12,4" Margin="0,0,8,0"/>
        </StackPanel>

        <!-- Место под Хронологию (шаги 7-8) и RestorePlan (шаг 6, агент) -->
        <TextBlock Grid.Row="3" Text="Хронология и восстановление появятся в следующих шагах"
                   FontSize="12" Foreground="LightGray"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>
</Window>
